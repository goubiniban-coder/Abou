# Base PostgreSQL. En production sur Vercel, utiliser le pooler Supabase en mode transaction
# (port 6543) : le mode session (5432) sature vite avec les fonctions serverless.
DATABASE_URL=postgres://abou:abou@localhost:5432/abou

# Mot de passe d'accès au back-office. Sans valeur, l'application est ouverte (développement).
ADMIN_PASSWORD=
# Clé de signature des sessions (chaîne aléatoire longue)
AUTH_SECRET=

# Sentry (facultatif) : remontée des erreurs de production. Sans DSN, rien n'est envoyé.
NEXT_PUBLIC_SENTRY_DSN=
# Envoi des source maps au build (pour des piles d'erreurs lisibles)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
